#. ai_claude_cache label
msgid "Claude Code — cache & logs"
msgstr "Claude Code — bộ nhớ đệm & nhật ký"

#. ai_claude_cache description
msgid ""
"Claude Code caches, MCP logs, week-old shell snapshots and backups. Memory, "
"settings and logins are kept."
msgstr ""
"Bộ nhớ đệm, nhật ký MCP, snapshot shell và bản sao lưu đã một tuần của "
"Claude Code. Memory, cài đặt và đăng nhập được giữ."

#. ai_claude_history label
msgid "Claude Code — old sessions"
msgstr "Claude Code — phiên cũ"

#. ai_claude_history description
#, python-brace-format
msgid ""
"Session transcripts, checkpoints and todos older than {0} days. Memory, "
"settings and logins are kept."
msgstr ""
"Bản ghi phiên, checkpoint và todo cũ hơn {0} ngày. Memory, cài đặt và đăng "
"nhập được giữ."

#. ai_claude_history why, ai_claude_desktop_history why, ai_codex_history why, ai_gemini_history why, ai_opencode_history why, ai_misc_history why
#, python-brace-format
