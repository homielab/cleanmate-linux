msgid "Main menu"
msgstr "Menu chính"

#: gui/cleanmate_gui/window.py:124
msgid "Dry run — nothing will be deleted"
msgstr "Chạy thử — không có gì bị xoá"

#: gui/cleanmate_gui/window.py:157
msgid "Cleanup"
msgstr "Dọn dẹp"

#: gui/cleanmate_gui/window.py:157
msgid "Tools"
msgstr "Công cụ"

#: gui/cleanmate_gui/window.py:157
msgid "More"
msgstr "Thêm"

