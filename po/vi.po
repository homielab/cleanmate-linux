#: gui/cleanmate_gui/welcome.py:66
msgid "Your options"
msgstr "Tuỳ chọn của bạn"

#: gui/cleanmate_gui/welcome.py:67
msgid "Change them any time in Settings, in the main menu (Ctrl+,)."
msgstr "Đổi lúc nào cũng được trong Cài đặt, ở menu chính (Ctrl+,)."

#: gui/cleanmate_gui/welcome.py:75
msgid "Skip"
msgstr "Bỏ qua"

#: gui/cleanmate_gui/welcome.py:77
msgid "Back"
msgstr "Quay lại"

#: gui/cleanmate_gui/welcome.py:79 gui/cleanmate_gui/welcome.py:200
msgid "Next"
msgstr "Tiếp"

#: gui/cleanmate_gui/welcome.py:99
msgid "Free up disk space and keep Ubuntu tidy — safely."
msgstr "Giải phóng dung lượng và giữ Ubuntu gọn gàng — an toàn."

#: gui/cleanmate_gui/welcome.py:101
msgid ""
"Junk in your home folder in one scan: caches, old app logs, developer and AI "
"tool junk and the Trash."
msgstr ""
"Rác trong thư mục riêng chỉ với một lần quét: bộ nhớ đệm, nhật ký ứng dụng "
"cũ, rác của công cụ lập trình và AI, và Thùng rác."

#: gui/cleanmate_gui/welcome.py:103
msgid "Large & Old Files and Duplicates"
msgstr "Tệp lớn & cũ và Tệp trùng lặp"

#: gui/cleanmate_gui/welcome.py:104
msgid ""
"Find big, old and duplicate files and move the ones you pick to the Trash."
msgstr ""
"Tìm tệp lớn, cũ và trùng lặp, rồi chuyển những tệp bạn chọn vào Thùng rác."

#: gui/cleanmate_gui/welcome.py:106
msgid ""
"System, developer and AI tool junk in one scan: caches, old logs, unused "
"packages and what removed apps left behind."
msgstr ""
"Rác hệ thống, rác developer và rác công cụ AI trong một lần quét: bộ nhớ "
"đệm, nhật ký cũ, gói không dùng và những gì ứng dụng đã gỡ để lại."

#: gui/cleanmate_gui/welcome.py:109
msgid "Remove apps and the folders they leave in your home."
msgstr "Gỡ ứng dụng và các thư mục chúng để lại trong thư mục nhà."

#: gui/cleanmate_gui/welcome.py:110
msgid "What it does"
msgstr "CleanMate làm gì"

#: gui/cleanmate_gui/welcome.py:113
msgid "Browser history and cookies, terminal history and recent files."
msgstr "Lịch sử và cookie trình duyệt, lịch sử terminal và tệp gần đây."

#: gui/cleanmate_gui/welcome.py:115
msgid "See what takes up the space, folder by folder."
msgstr "Xem thứ gì chiếm chỗ, từng thư mục một."

#: gui/cleanmate_gui/welcome.py:117
msgid "How it stays safe"
msgstr "Cách CleanMate giữ an toàn"

#: gui/cleanmate_gui/welcome.py:118
msgid "You see everything first"
msgstr "Bạn xem trước mọi thứ"

#: gui/cleanmate_gui/welcome.py:119
msgid ""
"Each clean lists the items and their sizes, and nothing is removed until you "
"confirm."
msgstr ""
"Mỗi lần dọn đều liệt kê các mục và dung lượng của chúng, và không có gì bị "
"xoá cho đến khi bạn xác nhận."

#: gui/cleanmate_gui/welcome.py:120
msgid "Your files go to the Trash"
msgstr "Tệp của bạn vào Thùng rác"

#: gui/cleanmate_gui/welcome.py:121
msgid ""
"Caches and logs that apps make again are deleted. Your own files go to the "
"Trash, and Undo puts them back."
msgstr ""
"Bộ nhớ đệm và nhật ký mà ứng dụng tự tạo lại thì bị xoá. Tệp của chính bạn "
"vào Thùng rác, và Hoàn tác trả chúng lại."

#: gui/cleanmate_gui/welcome.py:123
msgid "Open source, no data collected"
msgstr "Mã nguồn mở, không thu thập dữ liệu"

#: gui/cleanmate_gui/welcome.py:124
msgid ""
"Nothing about you is sent anywhere. The only connection is a daily check for "
"a new version, which you can turn off; installed from a package, there is "
"none."
msgstr ""
"Không có gì về bạn được gửi đi. Kết nối duy nhất là kiểm tra phiên bản mới "
"mỗi ngày, bạn tắt được; khi cài bằng gói thì không có."

#: gui/cleanmate_gui/welcome.py:131
msgid "What needs your password"
msgstr "Những gì cần mật khẩu"

#: gui/cleanmate_gui/welcome.py:132
msgid "Most cleaning runs as you, without a password."
msgstr "Phần lớn việc dọn chạy bằng tài khoản của bạn, không cần mật khẩu."

#: gui/cleanmate_gui/welcome.py:134
msgid "Items with a lock"
msgstr "Mục có ổ khoá"

#: gui/cleanmate_gui/welcome.py:135
msgid ""
"The APT cache, system logs, old kernels and old Snap versions belong to the "
"system. Cleaning them asks for your password in Ubuntu's own dialog; so do "
"removing apt and Snap apps and Maintenance tasks."
msgstr ""
"Bộ nhớ đệm APT, nhật ký hệ thống, kernel cũ và phiên bản Snap cũ thuộc về hệ "
"thống. Dọn chúng sẽ hỏi mật khẩu qua hộp thoại của chính Ubuntu; gỡ ứng dụng "
"apt, Snap và các tác vụ Bảo trì cũng vậy."

#: gui/cleanmate_gui/welcome.py:139
msgid ""
"Cleans only user and developer junk, so it never asks for your password."
msgstr ""
"Chỉ dọn rác người dùng và rác developer, nên không bao giờ hỏi mật khẩu."

#: gui/cleanmate_gui/welcome.py:140
msgid "Snap, Flatpak and AppImage"
msgstr "Snap, Flatpak và AppImage"

#: gui/cleanmate_gui/welcome.py:141
msgid ""
"Apps from apt, Snap, Flatpak and AppImage are all found, with their caches "
"and leftovers."
msgstr ""
"Ứng dụng từ apt, Snap, Flatpak và AppImage đều được nhận ra, cùng bộ nhớ đệm "
"và phần còn sót lại của chúng."

#: gui/cleanmate_gui/welcome.py:143 gui/cleanmate_gui/welcome.py:177
msgid "Never touched"
msgstr "Không bao giờ đụng tới"

#: gui/cleanmate_gui/welcome.py:144 gui/cleanmate_gui/welcome.py:178
msgid "Logins and keys"
msgstr "Thông tin đăng nhập và khoá"

#: gui/cleanmate_gui/welcome.py:145 gui/cleanmate_gui/welcome.py:179
msgid ".ssh, .gnupg and saved logins, your settings and bookmarks."
msgstr ""
".ssh, .gnupg và thông tin đăng nhập đã lưu, cài đặt và dấu trang của bạn."

#: gui/cleanmate_gui/welcome.py:146
msgid "Your documents"
msgstr "Tài liệu của bạn"

#: gui/cleanmate_gui/welcome.py:147
msgid ""
"Nothing of yours is removed unless you tick it in Space Lens, Large & Old "
"Files or Duplicates — and then it goes to the Trash."
msgstr ""
"Không gì của bạn bị xoá trừ khi bạn tự chọn nó trong Space Lens, Tệp lớn & "
"cũ hoặc Tệp trùng lặp — và khi đó nó vào Thùng rác."

#: gui/cleanmate_gui/welcome.py:149
msgid "The kernel you run"
msgstr "Kernel đang chạy"

#: gui/cleanmate_gui/welcome.py:150
msgid "Old kernels can go, but never the one you run or the one before it."
msgstr ""
"Kernel cũ có thể được dọn, nhưng không bao giờ là kernel đang chạy hay "
"kernel ngay trước nó."

#: gui/cleanmate_gui/welcome.py:153
msgid "The terminal app"
msgstr "App terminal"

#: gui/cleanmate_gui/welcome.py:154
msgid ""
"Run cm in a terminal for every tool, also over SSH. sudo cm cleans the "
"system items in one go."
msgstr ""
"Chạy cm trong terminal để có mọi công cụ, cả qua SSH. sudo cm dọn các mục hệ "
"thống trong một lượt."

#: gui/cleanmate_gui/welcome.py:156 gui/cleanmate_gui/window.py:158
msgid "All tools (terminal)"
msgstr "Mọi công cụ (terminal)"

#
#: gui/cleanmate_gui/welcome.py:156 gui/cleanmate_gui/window.py:159
msgid "Open the terminal app (cm)"
msgstr "Mở app terminal (cm)"

#: gui/cleanmate_gui/welcome.py:170
msgid "What the Flatpak reaches"
msgstr "Bản Flatpak với tới đâu"

#: gui/cleanmate_gui/welcome.py:171
msgid "It runs as you, inside your home folder."
msgstr "Nó chạy với quyền của bạn, trong thư mục riêng của bạn."

#: gui/cleanmate_gui/welcome.py:173
msgid "Your home folder"
msgstr "Thư mục riêng của bạn"

#: gui/cleanmate_gui/welcome.py:174
msgid ""
"Caches, old app logs, developer and AI tool junk and the Trash. Your own "
"files only when you pick them in Space Lens, Large & Old Files or Duplicates "
"— and then they go to the Trash."
msgstr ""
"Bộ nhớ đệm, nhật ký ứng dụng cũ, rác của công cụ lập trình và AI, và Thùng "
"rác. Tệp của chính bạn chỉ khi bạn tự chọn chúng trong Space Lens, Tệp lớn & "
"cũ hoặc Tệp trùng lặp — và khi đó chúng vào Thùng rác."

#: gui/cleanmate_gui/window.py:69
msgid ""
"Scan everything in one go and clean what you don't need. Nothing is removed "
"until you confirm."
msgstr ""
"Quét mọi thứ một lần và dọn những gì bạn không cần. Không có gì bị xoá cho "
"đến khi bạn xác nhận."

#: gui/cleanmate_gui/window.py:72
msgid ""
"Package cache, unused packages and kernels, leftover configs, old Snap "
"revisions, temp files."
msgstr ""
"Bộ nhớ đệm gói, gói và kernel không dùng, cấu hình còn sót, bản Snap cũ, tệp "
"tạm."

#: gui/cleanmate_gui/window.py:74
msgid ""
"Systemd journal, oversized and rotated logs, crash reports, old app logs."
msgstr ""
"Systemd journal, nhật ký quá lớn và đã xoay vòng, báo cáo lỗi, nhật ký ứng "
"dụng cũ."

#: gui/cleanmate_gui/window.py:76
msgid ""
"Trash, thumbnails, stale caches — and every browser and app cache on its own."
msgstr ""
"Thùng rác, ảnh thu nhỏ, bộ nhớ đệm cũ — và bộ nhớ đệm của từng trình duyệt, "
"từng ứng dụng."

#: gui/cleanmate_gui/window.py:78
msgid ""
"Caches, logs and old chat sessions of Claude, Codex, Gemini/Antigravity, "
"opencode, ZCode, Zed and more — and downloaded Ollama, Hugging Face and LM "
"Studio models, each on its own."
msgstr ""
"Bộ nhớ đệm, nhật ký và phiên chat cũ của Claude, Codex, Gemini/Antigravity, "
"opencode, ZCode, Zed và nhiều công cụ khác — cùng các mô hình Ollama, "
"Hugging Face và LM Studio đã tải, từng mô hình riêng."

#: gui/cleanmate_gui/window.py:81
msgid ""
"Stale node_modules and project build folders, npm, pip, Go, Cargo, Conda, "
"Docker and Podman leftovers, Firebase CLI logs."
msgstr ""
"node_modules và thư mục build cũ của dự án, phần còn sót của npm, pip, Go, "
"Cargo, Conda, Docker và Podman, nhật ký Firebase CLI."

#: gui/cleanmate_gui/window.py:84
msgid ""
"Browser history and cookies, terminal history, recent files, run dialog and "
"emoji history."
msgstr ""
"Lịch sử và cookie trình duyệt, lịch sử terminal, tệp gần đây, hộp thoại chạy "
"lệnh và lịch sử emoji."

#: gui/cleanmate_gui/window.py:87
msgid ""
"See what takes up the space, folder by folder, and move what you don't need "
"to the Trash. You can undo it."
msgstr ""
"Xem thứ gì chiếm chỗ, từng thư mục một, và chuyển những gì không cần vào "
"Thùng rác. Bạn có thể hoàn tác."

#: gui/cleanmate_gui/window.py:90
msgid ""
"Find the biggest files, or the ones you haven't opened in months, and move "
"what you don't need to the Trash. You can undo it."
msgstr ""
"Tìm các tệp lớn nhất, hoặc tệp bạn nhiều tháng chưa mở, và chuyển những gì "
"không cần vào Thùng rác. Bạn có thể hoàn tác."

#: gui/cleanmate_gui/window.py:93
msgid ""
"Find identical files, keep one copy of each and move the others to the "
"Trash. You can undo it."
msgstr ""
"Tìm các tệp giống hệt nhau, giữ một bản mỗi tệp và chuyển các bản còn lại "
"vào Thùng rác. Bạn có thể hoàn tác."

#: gui/cleanmate_gui/window.py:95
msgid ""
"Remove apps from apt, Snap, Flatpak and AppImage, and the folders they leave "
"in your home."
msgstr ""
"Gỡ ứng dụng apt, Snap, Flatpak và AppImage, cùng các thư mục chúng để lại "
"trong thư mục nhà."

#: gui/cleanmate_gui/window.py:97
msgid "Choose which apps and services start when you log in."
msgstr "Chọn app và dịch vụ nào khởi động khi bạn đăng nhập."

#
#: gui/cleanmate_gui/window.py:98
msgid "Maintenance"
msgstr "Bảo trì"

#: gui/cleanmate_gui/window.py:99
msgid ""
"Update everything, repair packages, TRIM, rebuild caches, and keep snap "
"versions and system logs from piling up again."
msgstr ""
"Cập nhật mọi thứ, sửa gói, TRIM, dựng lại bộ đệm, và giữ cho bản snap cũ "
"cùng nhật ký hệ thống không chất đống lại."

#
#: gui/cleanmate_gui/window.py:101 gui/cleanmate_gui/window.py:207
msgid "System Overview"
msgstr "Tổng quan hệ thống"

#: gui/cleanmate_gui/window.py:102
msgid ""
"Your system, disks, free space over time, memory, the space CleanMate freed, "
"and your largest folders."
msgstr ""
"Hệ thống, ổ đĩa, dung lượng trống theo thời gian, bộ nhớ, dung lượng "
"CleanMate đã giải phóng và các thư mục lớn nhất của bạn."

#: gui/cleanmate_gui/window.py:105
msgid ""
"Everything CleanMate moved to the Trash, also in earlier sessions. Put back "
"one item, a few or all."
msgstr ""
"Mọi thứ CleanMate đã chuyển vào Thùng rác, kể cả ở các lần trước. Trả lại "
"một mục, vài mục hoặc tất cả."

#: gui/cleanmate_gui/window.py:109
msgid ""
"Old installers, downloads and screenshots, and unfinished downloads. The "
"package cache, old kernels and snaps are out of the Flatpak's reach."
msgstr ""
"Bộ cài cũ, tệp tải về và ảnh chụp màn hình cũ, tệp tải dở. Bộ đệm gói, "
"kernel cũ và snap nằm ngoài tầm của bản Flatpak."

#: gui/cleanmate_gui/window.py:111
msgid ""
"Old app logs. The systemd journal, /var/log and crash reports are out of the "
"Flatpak's reach."
msgstr ""
"Nhật ký ứng dụng cũ. Nhật ký systemd, /var/log và báo cáo lỗi nằm ngoài tầm "
"của bản Flatpak."

#: gui/cleanmate_gui/window.py:174 gui/cleanmate_gui/window.py:309
#: gui/cleanmate_gui/window.py:317
msgid "Keyboard Shortcuts"
msgstr "Phím tắt"

#: gui/cleanmate_gui/window.py:176
msgid "Open the terminal app"
msgstr "Mở app terminal"

#: gui/cleanmate_gui/window.py:179
msgid "Getting Started…"
msgstr "Hướng dẫn bắt đầu…"

#: gui/cleanmate_gui/window.py:181
msgid "Suggest a Feature…"
msgstr "Góp ý tính năng…"

#: gui/cleanmate_gui/window.py:182
msgid "Share CleanMate"
msgstr "Chia sẻ CleanMate"

#: gui/cleanmate_gui/window.py:183 gui/cleanmate_gui/window.py:496
msgid "Source code"
msgstr "Mã nguồn"

#: gui/cleanmate_gui/window.py:187
msgid "About CleanMate"
msgstr "Giới thiệu CleanMate"

#: gui/cleanmate_gui/window.py:191
msgid "Main menu"
msgstr "Menu chính"

#: gui/cleanmate_gui/window.py:205
msgid "Dry run — nothing will be deleted"
msgstr "Chạy thử — không có gì bị xoá"

#: gui/cleanmate_gui/window.py:256
msgid "Cleanup"
msgstr "Dọn dẹp"

#: gui/cleanmate_gui/window.py:256
msgid "Tools"
msgstr "Công cụ"

#
#: gui/cleanmate_gui/window.py:311
msgid "Pages"
msgstr "Trang"

#: gui/cleanmate_gui/window.py:314
msgid "Scan, search or list again"
msgstr "Quét, tìm hoặc liệt kê lại"

#: gui/cleanmate_gui/window.py:318
msgid "Quit"
msgstr "Thoát"

#: gui/cleanmate_gui/window.py:320
msgid "Show or hide hidden files"
msgstr "Hiện hoặc ẩn tệp ẩn"

#: gui/cleanmate_gui/window.py:364
msgid "Stop and close?"
msgstr "Dừng và đóng?"

#: gui/cleanmate_gui/window.py:365
msgid ""
"CleanMate is still changing files. Closing now stops it partway: what is "
"done stays done, the rest is left as it was."
msgstr ""
"CleanMate vẫn đang thay đổi tệp. Đóng bây giờ sẽ dừng giữa chừng: phần đã "
"xong vẫn giữ, phần còn lại để nguyên."

#: gui/cleanmate_gui/window.py:367
msgid "Keep Running"
msgstr "Tiếp tục chạy"

#: gui/cleanmate_gui/window.py:368
msgid "Stop and Close"
msgstr "Dừng và đóng"

#: gui/cleanmate_gui/window.py:398
msgid "Cleanup complete"
msgstr "Đã dọn xong"

#: gui/cleanmate_gui/window.py:448
#, python-brace-format
msgid "{free} free of {total}"
msgstr "Còn trống {free} / {total}"

#: gui/cleanmate_gui/window.py:451
#, python-brace-format
msgid "{disk}: {free} free of {total}"
msgstr "{disk}: còn trống {free} / {total}"

#: gui/cleanmate_gui/window.py:465
msgid "No terminal app found — run cm in a terminal."
msgstr "Không tìm thấy app terminal — hãy chạy cm trong terminal."

#: gui/cleanmate_gui/window.py:493
msgid "translator-credits"
msgstr "HomieLab https://homielab.com"

#: gui/cleanmate_gui/window.py:494
msgid ""
"A friendly system cleaner for Ubuntu, inspired by CleanMyMac. Not affiliated "
"with MacPaw."
msgstr ""
"Trình dọn dẹp hệ thống thân thiện cho Ubuntu, lấy cảm hứng từ CleanMyMac. "
"Không liên kết với MacPaw."

#. apt_cache label
msgid "APT package cache"
msgstr "Bộ nhớ đệm gói APT"

#. apt_cache description
msgid "Downloaded .deb installers. apt re-downloads them if ever needed."
msgstr "Bộ cài .deb đã tải. apt tải lại nếu cần."

#. apt_cache why, packagekit_cache why, thumbs why, app_cache why, node_modules why, npm why
msgid ""
"Deleted, not moved to the Trash: the app or tool makes it again when it "
"needs it"
msgstr "Xoá thẳng, không vào Thùng rác: app hoặc công cụ tự tạo lại khi cần"

#. apt_cache why, packagekit_cache why, orphans why, residual why, journal why, old_logs why
msgid "Asks for your password: these are system files"
msgstr "Hỏi mật khẩu của bạn: đây là file hệ thống"

#. apt_cache why, packagekit_cache why, orphans why, residual why, journal why, old_logs why
msgid "If you cancel the password prompt"
msgstr "Khi bạn huỷ hộp hỏi mật khẩu"

#. apt_cache why, packagekit_cache why, old_installers why, old_downloads why, old_screenshots why, abandoned_downloads why
msgid "Automatic cleaning leaves it alone"
msgstr "Dọn tự động không đụng tới"

#. packagekit_cache label
msgid "PackageKit cache"
msgstr "Bộ nhớ đệm PackageKit"

#. packagekit_cache description
msgid ""
"Packages and package lists GNOME Software and Software Updater downloaded. "
"They are downloaded again when needed."
msgstr ""
"Gói và danh sách gói mà GNOME Software và Software Updater đã tải. Chúng "
"được tải lại khi cần."

#. packagekit_cache why
msgid "GNOME Software"
msgstr "GNOME Software"

#. packagekit_cache why
msgid "Software Updater"
msgstr "Trình cập nhật phần mềm"

#. old_installers label
msgid "Old installers in Downloads"
msgstr "Bộ cài cũ trong Tải về"

#. old_installers description
#, python-brace-format
msgid ""
"Installers and disk images (.deb, AppImage, .iso, .img, .run, .snap, "
"Flatpak) at the top of your Downloads folder, downloaded more than {0} days "
"ago. Moved to the Trash."
msgstr ""
"Bộ cài và ảnh đĩa (.deb, AppImage, .iso, .img, .run, .snap, Flatpak) ngay "
"trong thư mục Tải về, tải về hơn {0} ngày trước. Chuyển vào Thùng rác."

#. old_installers why, old_downloads why, old_screenshots why, abandoned_downloads why, stale_build_dirs why, vscode_stale_workspaces why
msgid "Moved to the Trash: you can put it back until you empty the Trash"
msgstr "Chuyển vào Thùng rác: bạn lấy lại được cho tới khi đổ Thùng rác"

#. old_installers why, old_downloads why, old_screenshots why, abandoned_downloads why, old_kernels why, trash_drives why
msgid "Not ticked by default: it is cleaned only if you tick it"
msgstr "Mặc định không tick: chỉ dọn khi bạn tick"

#. old_installers why
#, python-brace-format
msgid "Installers downloaded in the last {0} days"
msgstr "Bộ cài tải về trong {0} ngày qua"

#. old_installers why
msgid "Anything inside a folder of Downloads (only the top of it is looked at)"
msgstr "Mọi thứ nằm trong một thư mục con của Tải về (chỉ xét lớp trên cùng)"

#. old_downloads description
#, python-brace-format
msgid ""
"Files and folders at the top of your Downloads folder that you haven't "
"opened or changed for more than {0} days. Moved to the Trash."
msgstr ""
"Tệp và thư mục ngay trong thư mục Tải về mà bạn không mở hay sửa hơn {0} "
"ngày. Chuyển vào Thùng rác."

#. old_downloads why, old_screenshots why
#, python-brace-format
msgid "Anything opened or changed in the last {0} days"
msgstr "Mọi thứ mở hoặc sửa trong {0} ngày qua"

#. old_screenshots label
msgid "Old screenshots"
msgstr "Ảnh chụp màn hình cũ"

#. old_screenshots description
#, python-brace-format
msgid ""
"Screenshots and screen recordings in your Pictures folder and its "
"Screenshots folder that you haven't opened or changed for more than {0} "
"days. Moved to the Trash."
msgstr ""
"Ảnh chụp và video quay màn hình trong thư mục Ảnh và thư mục Screenshots của "
"nó mà bạn không mở hay sửa hơn {0} ngày. Chuyển vào Thùng rác."

#. old_screenshots why
msgid "Other pictures: only screenshots and screen recordings are looked at"
msgstr "Ảnh khác: chỉ xét ảnh chụp màn hình và video quay màn hình"

#. abandoned_downloads label
msgid "Abandoned downloads"
msgstr "Tải về bỏ dở"

#. abandoned_downloads description
#, python-brace-format
msgid ""
"Unfinished downloads (.crdownload, .part, .aria2, .!qB) at the top of your "
"Downloads folder that haven't changed or been opened for more than {0} days. "
"Moved to the Trash."
msgstr ""
"Tệp tải chưa xong (.crdownload, .part, .aria2, .!qB) ngay trong thư mục Tải "
"về mà không được sửa hay mở hơn {0} ngày. Chuyển vào Thùng rác."

#. abandoned_downloads why
#, python-brace-format
msgid "Downloads that changed or were opened in the last {0} days"
msgstr "File tải về được sửa hoặc mở trong {0} ngày qua"

#. orphans label
msgid "Unused packages & old kernels"
msgstr "Gói không dùng & kernel cũ"

#. orphans description
msgid ""
"Packages installed as dependencies that nothing needs any more (apt "
"autoremove)."
msgstr "Gói được cài làm phụ thuộc mà không còn gì cần (apt autoremove)."

#. orphans why
msgid ""
"Packages apt installed only because another package needed them (apt "
"autoremove)"
msgstr "Gói apt chỉ cài vì gói khác cần (apt autoremove)"

#. orphans why, residual why, journal why, old_logs why, big_logs why, app_logs why
msgid "Deleted for good, not moved to the Trash"
msgstr "Xoá hẳn, không vào Thùng rác"

#. orphans why
msgid "apt can install them again"
msgstr "apt cài lại được"

#. orphans why
msgid ""
"Packages you installed yourself, and anything an installed package still "
"needs"
msgstr "Gói bạn tự cài, và mọi thứ một gói đang cài còn cần"

#. residual label
msgid "Leftover package configs"
msgstr "Cấu hình gói còn sót"

#. residual description
msgid "System config files of packages that were removed but not purged."
msgstr "Tệp cấu hình hệ thống của gói đã gỡ nhưng chưa purge."

#. residual why
msgid "System config files (/etc) of packages that were removed but not purged"
msgstr "File cấu hình hệ thống (/etc) của gói đã gỡ nhưng chưa purge"

#. residual why
msgid "Packages that are still installed"
msgstr "Gói vẫn đang cài"

#
#. journal label
msgid "Systemd journal logs"
msgstr "Nhật ký systemd journal"

#. journal description
#, python-brace-format
msgid "Archived system logs. Keeps the last {0} days and at most {1} MB."
msgstr "Nhật ký hệ thống đã lưu trữ. Giữ {0} ngày gần nhất và tối đa {1} MB."

#. journal why
#, python-brace-format
msgid "The last {0} days and the newest {1} MB of logs"
msgstr "Log {0} ngày gần nhất và {1} MB log mới nhất"

#. old_logs label
msgid "Rotated / archived logs"
msgstr "Nhật ký đã xoay vòng / lưu trữ"

#. old_logs description
#, python-brace-format
msgid "Compressed or rotated log files in /var/log (*.gz, *.{0}, *.old)."
msgstr "Tệp nhật ký đã nén hoặc xoay vòng trong /var/log (*.gz, *.{0}, *.old)."

#. old_logs why
msgid "Logs still being written: only rotated and compressed files are removed"
msgstr "Log đang được ghi: chỉ xoá file đã xoay vòng và nén"

#
#. big_logs label
msgid "Oversized active logs"
msgstr "Nhật ký đang ghi quá lớn"

#. big_logs description
#, python-brace-format
msgid ""
"Live logs in /var/log over {0} MB, emptied in place — services keep logging "
"normally."
msgstr ""
"Nhật ký đang ghi trong /var/log lớn hơn {0} MB, được làm rỗng tại chỗ — dịch "
"vụ vẫn ghi nhật ký bình thường."

#. big_logs why
msgid "Emptied in place: the service keeps writing to the same file"
msgstr "Làm rỗng tại chỗ: dịch vụ vẫn ghi tiếp vào file đó"

#. big_logs why
#, python-brace-format
msgid "Logs under {0} MB"
msgstr "Log dưới {0} MB"

#
#. app_logs label
msgid "Old app logs"
msgstr "Nhật ký app cũ"

#. app_logs description
#, python-brace-format
msgid "Log files of apps (VS Code, Slack, …) not written for {0}+ days."
msgstr ""
"Tệp nhật ký của app (VS Code, Slack, …) không được ghi từ {0} ngày trở lên."

#. app_logs why
msgid ""
"The log folders of apps in ~/.config, ~/.local/share, ~/snap and ~/.var/app"
msgstr ""
"Thư mục log của các app trong ~/.config, ~/.local/share, ~/snap và ~/.var/app"

#. app_logs why
#, python-brace-format
msgid "Logs written in the last {0} days"
msgstr "Log ghi trong {0} ngày qua"

#. crash label
msgid "Crash reports"
msgstr "Báo cáo lỗi"

#. crash description
msgid "Apport crash reports in /var/crash."
msgstr "Báo cáo lỗi Apport trong /var/crash."

#. coredump label
msgid "Core dumps"
msgstr "Core dump"

#. coredump description
msgid "Memory dumps of crashed programs kept by systemd-coredump."
msgstr "Bản dump bộ nhớ của chương trình bị lỗi, do systemd-coredump giữ."

#. snap_old label
msgid "Old Snap revisions"
msgstr "Bản Snap cũ"

#. snap_old description
msgid "Disabled previous versions of snaps, kept only for rollback."
msgstr "Phiên bản snap cũ đã tắt, chỉ giữ để quay lại."

#. snap_old why
msgid "The snap can no longer go back to these versions"
msgstr "Snap không quay về được các phiên bản này nữa"

#. snap_old why
msgid "The version of each snap that runs now"
msgstr "Phiên bản đang chạy của mỗi snap"

#. old_kernels label
msgid "Extra old kernels"
msgstr "Kernel cũ thừa"

#. old_kernels description
msgid ""
"Kernels older than your two newest (never the one running), so a fallback "
"always stays."
msgstr ""
"Kernel cũ hơn hai bản mới nhất (không bao giờ là bản đang chạy), nên luôn "
"còn một bản dự phòng."

#. old_kernels why
msgid "The kernel that runs now and your two newest kernels"
msgstr "Kernel đang chạy và hai kernel mới nhất"

#
#. tmp label
msgid "Old temporary files"
msgstr "Tệp tạm cũ"

#. tmp description
#, python-brace-format
msgid "Your files in /tmp and /var/tmp not touched for {0}+ days."
msgstr ""
"Tệp của bạn trong /tmp và /var/tmp không được đụng tới từ {0} ngày trở lên."

#. tmp why
#, python-brace-format
msgid "Files used in the last {0} days"
msgstr "File dùng trong {0} ngày qua"

#. tmp why
msgid "Files of other users"
msgstr "File của người dùng khác"

#. thumbs label
msgid "Thumbnail cache"
msgstr "Bộ nhớ đệm ảnh thu nhỏ"

#. thumbs description
msgid "Image previews generated by the file manager; rebuilt on demand."
msgstr "Ảnh xem trước do trình quản lý tệp tạo; tạo lại khi cần."

#. thumbs why, trash why, npm why, yarn why, pnpm why, bun why
msgid "Its folder is in Settings › Never clean"
msgstr "Thư mục của nó nằm trong Cài đặt › Không bao giờ dọn"

#. trash label
msgid "Trash"
msgstr "Thùng rác"

#. trash description
msgid "Files you already deleted. Review before emptying!"
msgstr "Tệp bạn đã xoá. Xem lại trước khi dọn sạch!"

#. trash why
msgid "Emptying the Trash can't be undone"
msgstr "Đổ Thùng rác thì không hoàn tác được"

#. trash_drives label
msgid "Trash on external drives"
msgstr "Thùng rác trên ổ gắn ngoài"

#. trash_drives description
msgid ""
"Files you deleted on USB sticks and other drives stay in that drive's own "
"Trash and keep using its space. Emptying deletes them for good."
msgstr ""
"Tệp bạn đã xoá trên USB và ổ khác nằm trong Thùng rác riêng của ổ đó và vẫn "
"chiếm dung lượng. Dọn sạch sẽ xoá vĩnh viễn."

#. trash_drives why
msgid "The Trash folder of each USB stick or other drive you plugged in"
msgstr "Thùng rác của mỗi USB hoặc ổ khác bạn đã cắm"

#. trash_drives why
msgid "Emptying a Trash can't be undone"
msgstr "Đổ Thùng rác thì không hoàn tác được"

#. app_cache label
#, python-brace-format
msgid "Stale app caches (>{0} days)"
msgstr "Bộ nhớ đệm app cũ (>{0} ngày)"

#. app_cache description
#, python-brace-format
msgid "Files under ~/.cache not modified or read for {0}+ days."
msgstr "Tệp trong ~/.cache không sửa hay đọc từ {0} ngày trở lên."

#. app_cache why
#, python-brace-format
msgid "Files changed or read in the last {0} days"
msgstr "File sửa hoặc đọc trong {0} ngày qua"

#
#. node_modules label
msgid "Stale node_modules"
msgstr "node_modules cũ"

#. node_modules description
#, python-brace-format
msgid ""
"node_modules of projects untouched for {0}+ days. Restore with npm/yarn/pnpm "
"install."
msgstr ""
"node_modules của dự án không đụng tới từ {0} ngày trở lên. Khôi phục bằng "
"npm/yarn/pnpm install."

#. node_modules why
msgid "node_modules folders of your projects"
msgstr "Thư mục node_modules trong các dự án của bạn"

#. node_modules why, stale_build_dirs why
#, python-brace-format
msgid "Projects changed in the last {0} days"
msgstr "Dự án sửa trong {0} ngày qua"

#. node_modules why, stale_build_dirs why
msgid "Projects in a folder in Settings › Never clean"
msgstr "Dự án nằm trong một thư mục ở Cài đặt › Không bao giờ dọn"

#. stale_build_dirs label
msgid "Stale project build folders"
msgstr "Thư mục build cũ của dự án"

#. stale_build_dirs description
#, python-brace-format
msgid ""
"Build folders of projects untouched for {0}+ days, only next to the project "
"file that makes them: Cargo and Maven target/, Gradle and Android build/ "
"and .gradle/, Flutter .dart_tool/ and build/, SwiftPM .build/, Next.js, "
"Nuxt, SvelteKit, Angular and Turbo caches, Haskell .stack-work/ and dist-"
"newstyle/, Elixir _build/ and deps/, Zig caches, Python .venv/, CocoaPods "
"Pods/ and Terraform .terraform/providers and modules. Moved to the Trash; "
"the project's build tool makes them again."
msgstr ""
"Thư mục build của dự án không đụng tới từ {0} ngày trở lên, chỉ khi nằm cạnh "
"tệp dự án tạo ra nó: target/ của Cargo và Maven, build/ và .gradle/ của "
"Gradle và Android, .dart_tool/ và build/ của Flutter, .build/ của SwiftPM, "
"bộ nhớ đệm của Next.js, Nuxt, SvelteKit, Angular và Turbo, .stack-work/ và "
"dist-newstyle/ của Haskell, _build/ và deps/ của Elixir, bộ nhớ đệm Zig, ."
"venv/ của Python, Pods/ của CocoaPods và .terraform/providers, modules của "
"Terraform. Chuyển vào Thùng rác; công cụ build của dự án sẽ tạo lại."

#. stale_build_dirs why
msgid "Build folders next to the project file that makes them"
msgstr "Thư mục build cạnh file dự án tạo ra chúng"

#
#. npm label
msgid "npm cache"
msgstr "Bộ nhớ đệm npm"

#. npm description
msgid "npm's package download cache (~/.npm/_cacache)."
msgstr "Bộ nhớ đệm tải gói của npm (~/.npm/_cacache)."

#
#. yarn label
msgid "Yarn cache"
msgstr "Bộ nhớ đệm Yarn"

#. yarn description
msgid "Yarn's package download cache."
msgstr "Bộ nhớ đệm tải gói của Yarn."

#. pnpm label
msgid "pnpm store (unreferenced)"
msgstr "pnpm store (không được tham chiếu)"

#. pnpm description
msgid "Packages in the pnpm store no project references (pnpm store prune)."
msgstr "Gói trong pnpm store không dự án nào tham chiếu (pnpm store prune)."

#. pnpm why
msgid "Packages a project still uses (pnpm store prune)"
msgstr "Gói một dự án vẫn dùng (pnpm store prune)"

#
#. bun label
msgid "Bun cache"
msgstr "Bộ nhớ đệm Bun"

#. bun description
msgid "Bun's package install cache."
msgstr "Bộ nhớ đệm cài gói của Bun."

#
#. pip label
msgid "pip cache"
msgstr "Bộ nhớ đệm pip"

#. pip description
msgid "pip's wheel and HTTP download cache."
msgstr "Bộ nhớ đệm wheel và tải HTTP của pip."

#
#. gobuild label
msgid "Go build cache"
msgstr "Bộ nhớ đệm build Go"

#. gobuild description
msgid "Compiled Go build artifacts (go clean -cache)."
msgstr "Kết quả build Go đã biên dịch (go clean -cache)."

#. cargo label
msgid "Cargo registry cache"
msgstr "Bộ nhớ đệm registry Cargo"

#. cargo description
msgid "Downloaded and extracted crates; re-downloaded on next build."
msgstr "Crate đã tải và giải nén; tải lại ở lần build sau."

#
#. gradle label
msgid "Gradle caches"
msgstr "Bộ nhớ đệm Gradle"

#. gradle description
msgid "Gradle dependency and build caches; re-downloaded on next build."
msgstr "Bộ nhớ đệm phụ thuộc và build của Gradle; tải lại ở lần build sau."

#. maven label
msgid "Maven repository"
msgstr "Kho Maven"

#. maven description
msgid "Local Maven repository (~/.m2/repository); re-downloaded on next build."
msgstr "Kho Maven cục bộ (~/.m2/repository); tải lại ở lần build sau."

#. conda label
msgid "Conda package cache"
msgstr "Bộ nhớ đệm gói Conda"

#. conda description
msgid ""
"Downloaded package archives, index cache and logs (conda clean --tarballs). "
"Your environments are kept."
msgstr ""
"Gói nén đã tải, bộ nhớ đệm chỉ mục và nhật ký (conda clean --tarballs). Môi "
"trường của bạn được giữ."

#. conda why
msgid "Conda's package folders (pkgs)"
msgstr "Thư mục gói của Conda (pkgs)"

#. conda why
msgid ""
"Your environments: only downloaded archives, the index cache and logs go"
msgstr "Môi trường của bạn: chỉ xoá gói nén đã tải, cache chỉ mục và log"

#. docker_dangling label
msgid "Docker: dangling images"
msgstr "Docker: image lơ lửng"

#. docker_dangling description
msgid "Untagged leftover image layers from rebuilds — nothing uses them."
msgstr "Layer image không tag còn sót sau khi build lại — không gì dùng tới."

#. docker_dangling why
msgid "Docker's image store (docker image prune)"
msgstr "Kho image của Docker (docker image prune)"

#. docker_dangling why
msgid "Image layers a tagged image or a container uses"
msgstr "Lớp image mà một image có tag hoặc container đang dùng"

#
#. docker_build label
msgid "Docker: build cache"
msgstr "Docker: bộ nhớ đệm build"

#. docker_build description
msgid "BuildKit cache. Safe to remove; the next build is slower once."
msgstr "Bộ nhớ đệm BuildKit. Xoá an toàn; lần build sau chậm hơn một lần."

#. docker_build why
msgid "Docker's build cache (docker builder prune)"
msgstr "Cache build của Docker (docker builder prune)"

#. docker_containers label
msgid "Docker: stopped containers"
msgstr "Docker: container đã dừng"

#. docker_containers description
msgid ""
"Containers that aren't running. Anything stored inside them (not in volumes) "
"is lost."
msgstr ""
"Container không chạy. Mọi thứ lưu bên trong (không nằm trong volume) sẽ mất."

#. docker_containers why
msgid "Docker's stopped containers (docker container prune)"
msgstr "Container đã dừng của Docker (docker container prune)"

#. docker_containers why
msgid "Containers that are running"
msgstr "Container đang chạy"

#. docker_containers why, docker_volumes why
msgid ""
"Unattended cleaning (automatic, or cm --clean --yes): it may hold your data"
msgstr ""
"Dọn không người trông (tự động, hoặc cm --clean --yes): có thể chứa dữ liệu "
"của bạn"

#. docker_images label
msgid "Docker: unused images"
msgstr "Docker: image không dùng"

#. docker_images description
msgid "Images no container uses. They are pulled again when needed."
msgstr "Image không container nào dùng. Được pull lại khi cần."

#. docker_images why
msgid "Docker's images (docker image prune -a)"
msgstr "Image của Docker (docker image prune -a)"

#. docker_images why
msgid "Images a container uses, even a stopped one"
msgstr "Image một container dùng, kể cả container đã dừng"

#. docker_volumes label
msgid "Docker: unused volumes"
msgstr "Docker: volume không dùng"

#. docker_volumes description
msgid ""
"Volumes no container uses — they may hold databases or other data. Review "
"before removing!"
msgstr ""
"Volume không container nào dùng — có thể chứa cơ sở dữ liệu hoặc dữ liệu "
"khác. Xem lại trước khi xoá!"

#. docker_volumes why
msgid "Docker's volumes (docker volume prune)"
msgstr "Volume của Docker (docker volume prune)"

#. docker_volumes why
msgid "Volumes a container uses, even a stopped one"
msgstr "Volume một container dùng, kể cả container đã dừng"

#. podman label
msgid "Podman: stopped containers & dangling images"
msgstr "Podman: container đã dừng & image lơ lửng"

#. podman description
msgid ""
"podman system prune: stopped containers, untagged image layers and unused "
"networks. Volumes and tagged images are kept."
msgstr ""
"podman system prune: container đã dừng, layer image không tag và mạng không "
"dùng. Volume và image có tag được giữ."

#. podman why
msgid "Podman's containers and images (podman system prune)"
msgstr "Container và image của Podman (podman system prune)"

#. podman why
msgid "Running containers, volumes and tagged images"
msgstr "Container đang chạy, volume và image có tag"

#
#. game_launcher_caches label
msgid "Game launcher caches"
msgstr "Bộ nhớ đệm launcher game"

#. game_launcher_caches description
msgid ""
"Installers that winetricks and Wine downloaded, and the cover art and "
"temporary installers of Lutris and Heroic. Downloaded again when needed; "
"Wine prefixes, games and saves are kept. Close the launchers and games first."
msgstr ""
"Bộ cài mà winetricks và Wine đã tải, cùng ảnh bìa và bộ cài tạm của Lutris "
"và Heroic. Sẽ được tải lại khi cần; prefix Wine, game và bản lưu được giữ "
"nguyên. Hãy đóng launcher và game trước."

#. game_launcher_caches why
msgid ""
"The download caches of winetricks and Wine, and the cover art and installer "
"caches of Lutris and Heroic"
msgstr ""
"Cache tải về của winetricks và Wine, cache ảnh bìa và bộ cài của Lutris và "
"Heroic"

#. steam_caches label
msgid "Steam caches"
msgstr "Bộ nhớ đệm Steam"

#. steam_caches description
msgid ""
"The web cache of Steam's store and library pages, depot manifests, logs and "
"crash dumps. Steam downloads or writes them again; games, downloads, saves, "
"screenshots and your sign-in are kept. Close Steam first."
msgstr ""
"Bộ nhớ đệm web của trang cửa hàng và thư viện Steam, manifest depot, log và "
"bản dump khi Steam bị lỗi. Steam sẽ tải hoặc ghi lại; game, bản tải, bản "
"lưu, ảnh chụp màn hình và phiên đăng nhập được giữ nguyên. Hãy đóng Steam "
"trước."

#. steam_caches why
msgid ""
"The appcache, config/htmlcache, depotcache, logs and dumps folders of each "
"Steam folder"
msgstr ""
"Thư mục appcache, config/htmlcache, depotcache, logs và dumps của mỗi thư "
"mục Steam"

#. minecraft_caches label
msgid "Minecraft caches"
msgstr "Bộ nhớ đệm Minecraft"

#. minecraft_caches description
msgid ""
"Launcher logs, crash reports and web cache of Minecraft and Prism Launcher, "
"and the logs and crash reports of each Prism instance. Written again when "
"you play; worlds, mods, resource packs, screenshots, settings and accounts "
"are kept. Close the launcher and the game first."
msgstr ""
"Log, báo cáo lỗi và bộ nhớ đệm web của launcher Minecraft và Prism Launcher, "
"cùng log và báo cáo lỗi của từng instance Prism. Được ghi lại khi bạn chơi; "
"thế giới, mod, resource pack, ảnh chụp màn hình, cài đặt và tài khoản được "
"giữ nguyên. Hãy đóng launcher và game trước."

#. minecraft_caches why
msgid ""
"The logs, crash reports and web cache of ~/.minecraft and Prism Launcher"
msgstr "Log, báo cáo lỗi và cache web của ~/.minecraft và Prism Launcher"

#. minecraft_caches why
msgid "the Minecraft Launcher"
msgstr "Minecraft Launcher"

#. minecraft_caches why
msgid "Prism Launcher"
msgstr "Prism Launcher"

#. browser_firefox label
msgid "Firefox"
msgstr "Firefox"

#. browser_firefox description
msgid ""
"Web cache of Firefox (pages, images, scripts). Logins, history and bookmarks "
"are kept."
msgstr ""
"Bộ nhớ đệm web của Firefox (trang, ảnh, script). Đăng nhập, lịch sử và dấu "
"trang được giữ."

#. browser_chrome label
msgid "Google Chrome"
msgstr "Google Chrome"

#. browser_chrome description
msgid ""
"Web cache of Google Chrome (pages, images, scripts). Logins, history and "
"bookmarks are kept."
msgstr ""
"Bộ nhớ đệm web của Google Chrome (trang, ảnh, script). Đăng nhập, lịch sử và "
"dấu trang được giữ."

#. browser_chromium label
msgid "Chromium"
msgstr "Chromium"

#. browser_chromium description
msgid ""
"Web cache of Chromium (pages, images, scripts). Logins, history and "
"bookmarks are kept."
msgstr ""
"Bộ nhớ đệm web của Chromium (trang, ảnh, script). Đăng nhập, lịch sử và dấu "
"trang được giữ."

#. browser_brave label
msgid "Brave"
msgstr "Brave"

#. browser_brave description
msgid ""
"Web cache of Brave (pages, images, scripts). Logins, history and bookmarks "
"are kept."
msgstr ""
"Bộ nhớ đệm web của Brave (trang, ảnh, script). Đăng nhập, lịch sử và dấu "
"trang được giữ."

#. browser_edge label
msgid "Microsoft Edge"
msgstr "Microsoft Edge"

#. browser_edge description
msgid ""
"Web cache of Microsoft Edge (pages, images, scripts). Logins, history and "
"bookmarks are kept."
msgstr ""
"Bộ nhớ đệm web của Microsoft Edge (trang, ảnh, script). Đăng nhập, lịch sử "
"và dấu trang được giữ."

#. browser_vivaldi label
msgid "Vivaldi"
msgstr "Vivaldi"

#. browser_vivaldi description
msgid ""
"Web cache of Vivaldi (pages, images, scripts). Logins, history and bookmarks "
"are kept."
msgstr ""
"Bộ nhớ đệm web của Vivaldi (trang, ảnh, script). Đăng nhập, lịch sử và dấu "
"trang được giữ."

#. browser_opera label
msgid "Opera"
msgstr "Opera"

#. browser_opera description
msgid ""
"Web cache of Opera (pages, images, scripts). Logins, history and bookmarks "
"are kept."
msgstr ""
"Bộ nhớ đệm web của Opera (trang, ảnh, script). Đăng nhập, lịch sử và dấu "
"trang được giữ."

#. app_steam_shaders label
msgid "Steam — shader cache"
msgstr "Steam — bộ nhớ đệm shader"

#. app_steam_shaders description
msgid ""
"Shaders Steam compiled for your games. Steam rebuilds them; a game may "
"stutter briefly the first time."
msgstr ""
"Shader Steam đã biên dịch cho game của bạn. Steam tạo lại chúng; game có thể "
"giật nhẹ lần đầu."

#. priv_recent label
msgid "Recent files list"
msgstr "Danh sách tệp gần đây"

#. priv_recent description
msgid ""
"What Files and Open dialogs show under “Recent”. Only the list is cleared — "
"your files are not touched."
msgstr ""
"Những gì Tệp và hộp thoại Mở hiện ở mục “Gần đây”. Chỉ xoá danh sách — tệp "
"của bạn không bị đụng tới."

#. priv_recent why, priv_zsh why, priv_bash why, priv_fish why, priv_repl why, priv_misc why
msgid "Only the entries go: the file itself stays"
msgstr "Chỉ xoá các mục bên trong: file vẫn còn"

#
#. priv_zsh label
msgid "Zsh history"
msgstr "Lịch sử Zsh"

#. priv_zsh description
msgid "Every command you typed in zsh."
msgstr "Mọi lệnh bạn đã gõ trong zsh."

#
#. priv_bash label
msgid "Bash history"
msgstr "Lịch sử Bash"

#. priv_bash description
msgid "Every command you typed in bash (~/.bash_history)."
msgstr "Mọi lệnh bạn đã gõ trong bash (~/.bash_history)."

#
#. priv_fish label
msgid "Fish history"
msgstr "Lịch sử Fish"

#. priv_fish description
msgid "Every command you typed in fish."
msgstr "Mọi lệnh bạn đã gõ trong fish."

#. priv_repl label
msgid "Python, Node & database shells"
msgstr "Shell Python, Node & cơ sở dữ liệu"

#. priv_repl description
msgid ""
"History of the python, node, irb, mysql, psql, sqlite3 and redis-cli prompts."
msgstr ""
"Lịch sử dấu nhắc của python, node, irb, mysql, psql, sqlite3 và redis-cli."

#. priv_misc label
msgid "less & wget history"
msgstr "Lịch sử less & wget"

#. priv_misc description
msgid "Searches typed in less, and wget's list of visited HTTPS sites."
msgstr "Tìm kiếm đã gõ trong less, và danh sách trang HTTPS wget đã truy cập."

#. priv_editor label
msgid "Vim & Neovim history"
msgstr "Lịch sử Vim & Neovim"

#. priv_editor description
msgid ""
"Command and search history, marks and registers that Vim (~/.viminfo) and "
"Neovim (ShaDa) remember."
msgstr ""
